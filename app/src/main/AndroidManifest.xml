<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络通信 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 指纹 / 生物识别验证（BiometricPrompt 必须声明，缺失会闪退） -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- 扫码与相册 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 任务事件系统通知（Android 13+ 运行时申请 POST_NOTIFICATIONS） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 后台保活：前台服务常驻通知（Android 14 要求声明具体类型）与电池优化白名单引导 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 应用内更新：拉起系统安装器安装下载的 APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".ZCodeApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZCodeRemote"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 首页：设备管理与快捷连接；standard 模式（配合单实例去重）——
             从远程页"返回列表"时新实例压栈，不触发 singleTask 的清栈行为，
             从而保住后台 Remote 的 WebView（监听事件源继续存活）。
             切回 launcher 时由 onCreate 的 "现有页面自删恢复" 逻辑回到上次页面 -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 支持从外部网页或深层链接调起 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="zcode.z.ai"
                    android:pathPrefix="/remote"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 核心远程控制 WebView 沉浸式全屏界面；singleTop 避免从通知/列表
             重复创建多个实例叠加，已在栈顶时通过 onNewIntent 切换连接 -->
        <activity
            android:name=".ui.remote.RemoteControlActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ZCodeRemote.Fullscreen"
            android:windowSoftInputMode="adjustResize" />

        <!-- 二维码扫描页面 -->
        <activity
            android:name=".ui.scan.QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ZCodeRemote" />

        <!-- 应用设置：显示、主题与启动检查更新偏好 -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ZCodeRemote" />

        <!-- 通知管理设置 -->
        <activity
            android:name=".ui.settings.NotificationSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ZCodeRemote" />

        <activity
            android:name=".ui.settings.ThemeSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ZCodeRemote" />

        <activity
            android:name=".ui.security.SecuritySettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ZCodeRemote" />

        <activity
            android:name=".ui.security.SecurityVerifyActivity"
            android:exported="false"
            android:theme="@style/Theme.ZCodeRemote" />

        <!-- 关于页 -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.ZCodeRemote" />

        <!-- 后台保活前台服务：息屏时保持远程会话进程与连接存活 -->
        <service
            android:name=".service.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持远程控制会话在线，避免息屏后连接中断" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
