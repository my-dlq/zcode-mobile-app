<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 选定的第二组 24 号 Logo：圆角方底、斜向 Z、左侧速度线与蓝青下笔画。 -->
    <path
        android:pathData="M30,10 H78 C90,10 98,18 98,30 V78 C98,90 90,98 78,98 H30 C18,98 10,90 10,78 V30 C10,18 18,10 30,10 Z"
        android:fillColor="@color/logo_background"
        android:strokeWidth="1.5"
        android:strokeColor="@color/logo_border" />

    <!-- 上横笔与斜切中段，保留 24 号图的向右前冲姿态。 -->
    <path
        android:fillColor="@color/logo_mark"
        android:pathData="M38,28 H83 L71,42 H54 L34,69 H55 L43,82 H18 L55,39 H38 Z" />

    <!-- 下横笔使用两段颜色模拟蓝到青的渐变。 -->
    <path
        android:fillColor="@color/logo_accent"
        android:pathData="M34,69 H83 L71,82 H43 Z" />
    <path
        android:fillColor="@color/logo_accent_cyan"
        android:pathData="M59,69 H83 L71,82 H52 Z" />

    <!-- 左侧速度线：亮色/暗色主题保持同一位置，只切换对比度。 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M15,43 H31"
        android:strokeColor="@color/logo_accent"
        android:strokeLineCap="round"
        android:strokeWidth="3" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M12,51 H27"
        android:strokeColor="@color/logo_accent_cyan"
        android:strokeLineCap="round"
        android:strokeWidth="3" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M16,59 H29"
        android:strokeColor="@color/logo_accent"
        android:strokeLineCap="round"
        android:strokeWidth="3" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M18,66 H27"
        android:strokeColor="@color/logo_speed_coral"
        android:strokeLineCap="round"
        android:strokeWidth="2.5" />
</vector>
