<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 核心 WebView 容器 -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:fitsSystemWindows="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- 页面顶部精细加载进度条 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressDrawable="@drawable/bg_progress_bar"
        android:visibility="gone"
        tools:progress="60"
        tools:visibility="visible" />

    <!-- 会话健康指示胶囊：由 WebSocket/SSE 连接状态驱动 -->
    <include
        android:id="@+id/sessionHealth"
        layout="@layout/view_session_health" />

    <!-- 异常断网/加载失败占位覆盖层 -->
    <LinearLayout
        android:id="@+id/layoutErrorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_computer"
            app:tint="@color/danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/remote_load_failed"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="ERR_INTERNET_DISCONNECTED" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="@string/remote_retry"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/white" />
    </LinearLayout>

    <!-- 可拖动吸边悬浮控制球（当前按需求隐藏：仅 visibility=gone，代码逻辑未删除；恢复时删除该行即可） -->
    <ai.zcode.remote.ui.remote.FloatingControlView
        android:id="@+id/floatingControlView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="90dp"
        android:visibility="gone" />
</FrameLayout>
